{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
           "text": "China's average urban wage is 13 times higher than in 2000",
    "anchor": "start",
                "subtitle": ["Average annual wage, urban workers, nominal CNY", "Source: NBS via ECO API"],
    "fontSize": "14",
    "subtitleFontSize": "12",
    "color": "#000000",
    "subtitleColor": "#000000"
  },
      "height": 250,
     "width": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#ffffff",
  "view": {
    "fill": "#ffffff",
    "strokeOpacity": 0
  },
  "data": {
    "url": "https://api.economicsobservatory.com/chn/wage?vega",
    "format": {
      "type": "json"
    }
  },
  "mark": {
    "type": "bar",
    "color": "#5115f4",
    "strokeWidth": "2"
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {
        "title": "",
        "titleColor": "#122B39",
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "title": "",
        "titleColor": "#122B39",
        "grid": false
      }
    }
  }
}
