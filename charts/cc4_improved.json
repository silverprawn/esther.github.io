     "interval": "month",
     "step": 3
    },
    "grid": false,
    "labelAngle": 0
   }
  },
  "y": {
   "field": "value",
   "type": "quantitative",
   "title": null,
   "scale": {
    "domain": [
     0,
     2.5
    ]
   },
   "axis": {
    "values": [
     0,
     0.5,
     1,
     1.5,
     2,
     2.5
    ],
    "format": ".1f",
    "labelExpr": "datum.value == 2.5 ? datum.label + '%' : datum.label",
    "domain": false,
    "ticks": false,
    "gridColor": "#e5e5e5"
   }
  },
  "color": {
   "field": "label",
   "type": "nominal",
   "scale": {
    "domain": [
     "Core",
     "Excluding fuel",
     "Headline"
    ],
    "range": [
