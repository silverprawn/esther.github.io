      "title": "Month"
     },
     {
      "field": "value",
      "format": ".1f",
      "title": "Inflation (%)"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.last"
    }
   ],
   "mark": {
    "type": "circle",
    "size": 50
   }
  },
  {
   "transform": [
    {
     "filter": "datum.last"
    },
    {
     "calculate": "datum.label + ' ' + format(datum.value,'.1f') + '%'",
     "as": "endlab"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 8,
    "fontSize": 12,
    "fontWeight": "bold"
   },
   "encoding": {
    "text": {
     "field": "endlab"
    }
   }
  }
 ]
